# Example application settings. This package does not load .env automatically.
OAUTH_ENABLED=false
OAUTH_ISSUER=https://auth.example.com
OAUTH_RESOURCE=https://api.example.com/
OAUTH_PRIVATE_KEY_PATH=/path/outside-web-root/oauth-private.key
OAUTH_PUBLIC_KEY_PATH=/path/outside-web-root/oauth-public.key
OAUTH_ENCRYPTION_KEY=
OAUTH_SCOPES=user.list

# Optional GraphQL/application OAuth audience, distinct from the MCP resource.
# When blank, application authentication keeps using OAUTH_RESOURCE.
OAUTH_API_RESOURCE=

# Optional explicit source/target allowlist; absent/blank keeps exchange disabled.
# OAUTH_TOKEN_EXCHANGE_POLICY='{"hostlink-mcp":{"source":"https://mcp.example.com","targets":{"https://api.example.com/graphql":["client.list"]}}}'
OAUTH_TOKEN_EXCHANGE_TTL=PT5M

# Opt-in URL-based public OAuth clients (requires ext-curl and public HTTPS egress).
OAUTH_CIMD_ENABLED=false
