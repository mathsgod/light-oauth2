# Example application settings. This package does not load .env automatically.
OAUTH_ENABLED=false
OAUTH_ISSUER=https://auth.example.com
# Default audience when the authorization request omits resource.
OAUTH_RESOURCE=https://api.example.com/
# Compatibility allowlist when DB registry mode is disabled (comma-separated).
OAUTH_RESOURCES=
# Apply migration 002, seed trusted resources and assign clients before enabling.
# When true, resource and scope policy comes from oauth_resources, not this allowlist.
OAUTH_RESOURCE_REGISTRY_ENABLED=false
OAUTH_PRIVATE_KEY_PATH=/path/outside-web-root/oauth-private.key
OAUTH_PUBLIC_KEY_PATH=/path/outside-web-root/oauth-public.key
OAUTH_ENCRYPTION_KEY=
OAUTH_SCOPES=user.list

# Select client/user/provider scope intersection when authorize omits scope.
# Custom AuthorizationFlow implementations must support AutomaticScopes first.
OAUTH_AUTO_SELECT_SCOPES=false

# GraphQL/application identity used to validate token audiences.
# In DB mode this resource must also have an enabled oauth_resources record.
# When blank, application authentication keeps using OAUTH_RESOURCE.
OAUTH_API_RESOURCE=

# Optional explicit source/target allowlist; absent/blank keeps exchange disabled.
# OAUTH_TOKEN_EXCHANGE_POLICY='{"hostlink-mcp":{"source":"https://mcp.example.com","targets":{"https://api.example.com/graphql":["client.list"]}}}'
OAUTH_TOKEN_EXCHANGE_TTL=PT5M

# Opt-in URL-based public OAuth clients (requires ext-curl and public HTTPS egress).
OAUTH_CIMD_ENABLED=false

# Opt-in open registration for public PKCE clients; rate-limit at the application/proxy.
OAUTH_DCR_ENABLED=false

# Optional same-site Nuxt UI; leave blank to retain PHP-rendered login/consent.
# Configure light.oauth.apiBase in the Nuxt app to this API's public issuer URL.
OAUTH_AUTHORIZATION_UI_URL=
